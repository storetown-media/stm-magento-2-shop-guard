<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="storetown_shop_guard_bots" instance="Storetown\ShopGuard\Cron\AnalyzeTraffic" method="execute">
            <schedule>7 * * * *</schedule>
        </job>
        <job name="storetown_shop_guard_scan" instance="Storetown\ShopGuard\Cron\ScanFiles" method="execute">
            <schedule>*/30 * * * *</schedule>
        </job>
        <job name="storetown_shop_guard_rules" instance="Storetown\ShopGuard\Cron\UpdateRules" method="execute">
            <schedule>37 * * * *</schedule>
        </job>
        <job name="storetown_shop_guard_warnings" instance="Storetown\ShopGuard\Cron\AlertWarnings" method="execute">
            <schedule>41 * * * *</schedule>
        </job>
    </group>
</config>
